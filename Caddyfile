# Caddy — edge proxy (client address) and SSE proxy fallback
#
# 1. Client address: Caddy ignores X-Forwarded-For sent by clients (no trusted_proxies set)
#    and sets it to the real peer address. The API trusts X-Forwarded-For only from
#    TRUSTED_PROXY_CIDRS, so per-IP rate limits cannot be spoofed behind Caddy.
# 2. SSE: streams are proxied with flush_interval -1 so events are not buffered.
#
# Usage:
#   docker compose --profile edge up -d
#   Guest app: localhost:8080, owner app: localhost:8081
#   For public deployments expose only 8080/8081.
#
# See docs/decisions.md for rationale.

:8080 {
	# Guest app — static + API SSE
	handle /api/orders/*/stream {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy guest-web:3000
	}
}

:8081 {
	# Owner app — dashboard + kitchen SSE
	handle /api/restaurants/*/kitchen/stream {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}
	handle /api/restaurants/*/orders/stream {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}
	handle /api/* {
		reverse_proxy api:8000
	}
	handle {
		reverse_proxy owner-web:3001
	}
}
