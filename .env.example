# === .env.example ===

# --- App ---
APP_ENV=dev                              # dev | staging | production
                                         # non-dev rejects default secrets

# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mise
POSTGRES_USER=mise
POSTGRES_PASSWORD=change_me_in_production
SQL_ECHO=false

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change_me_in_production   # Signs all cookies

# --- Auth ---
OWNER_API_KEY=change_me_in_production
STAFF_PIN=0000

# --- URLs ---
PUBLIC_GUEST_URL=http://localhost:3000    # QR code base URL
PUBLIC_OWNER_URL=http://localhost:3001    # Owner dashboard URL

# --- Inference (Provider) ---
LLM_PROVIDER=mock                        # mock | amd
LLM_API_KEY=                             # NEVER commit a real key

# --- Inference (LLM) ---
LLM_BASE_URL=http://inference:8080/v1
LLM_MODEL=mock-llm
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30

# --- Inference (VLM) ---
VLM_BASE_URL=http://inference:8080/v1
VLM_MODEL=mock-vlm

# --- AMD Token Factory (uncomment to switch from mock) ---
# LLM_PROVIDER=amd
# LLM_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
# VLM_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
# LLM_MODEL=DeepSeek-V4-Flash
# VLM_MODEL=DeepSeek-V4.1-Flash
# LLM_GLOBAL_RPM=15

# --- Rate Limiting ---
LLM_GLOBAL_RPM=15                        # global requests per minute (AMD limit: 20)
GUEST_CHAT_LIMIT=10                      # per-session chat messages

# --- Demo ---
DEMO_MODE=false
DEMO_RESTAURANT_SLUG=trattoria-da-mario

# --- Mock control ---
MOCK_LATENCY_MS=100
MOCK_ERROR_RATE=0.0
MOCK_TIMEOUT_MS=0

# --- GPU cost ---
GPU_HOURLY_RATE_USD=0.00
