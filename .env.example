# === .env.example ===

# --- App ---
APP_ENV=dev                              # dev | staging | production
                                         # non-dev rejects default secrets

# --- Postgres ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=mise
POSTGRES_USER=mise
POSTGRES_PASSWORD=change_me_in_production
SQL_ECHO=false

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change_me_in_production   # Signs all cookies

# --- Auth ---
OWNER_API_KEY=change_me_in_production
STAFF_PIN=0000

# --- URLs ---
PUBLIC_GUEST_URL=http://localhost:3000    # QR code base URL
PUBLIC_OWNER_URL=http://localhost:3001    # Owner dashboard URL

# --- Inference (Provider & Free-Only Policy) ---
LLM_PROVIDER=mock                        # mock | openai_compatible
LLM_PRESET=custom                        # gemini | groq | openrouter | ollama | custom
LLM_PROVIDER_LABEL="OpenAI-compatible endpoint"
LLM_FREE_ONLY=true                       # Guard: prevents paid APIs, requires :free on openrouter
LLM_DAILY_REQUEST_CAP=200                # Daily request cap for non-local endpoints
LLM_API_KEY=                             # NEVER commit a real key

# --- Inference (LLM) ---
LLM_BASE_URL=http://inference:8080/v1
LLM_MODEL=mock-llm
LLM_MAX_TOKENS=1024
LLM_TIMEOUT_SECONDS=30

# --- Inference (VLM) ---
VLM_BASE_URL=http://inference:8080/v1
VLM_MODEL=mock-vlm

# --- OpenAI-Compatible Endpoint Example (uncomment to switch from mock) ---
# LLM_PROVIDER=openai_compatible
# LLM_PRESET=groq                        # or: gemini, openrouter, ollama, custom
# LLM_PROVIDER_LABEL="Groq Cloud"
# LLM_BASE_URL=https://api.groq.com/openai/v1
# VLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile
# VLM_MODEL=llama-3.2-11b-vision-preview
# LLM_API_KEY=gsk_your_key_here
# LLM_GLOBAL_RPM=20

# --- Rate Limiting ---
LLM_GLOBAL_RPM=15                        # global requests per minute ceiling
GUEST_CHAT_LIMIT=10                      # per-session chat messages

# --- Demo ---
DEMO_MODE=false
DEMO_RESTAURANT_SLUG=trattoria-da-mario

# --- Mock control ---
MOCK_LATENCY_MS=100
MOCK_ERROR_RATE=0.0
MOCK_TIMEOUT_MS=0

# --- Infrastructure ---
GPU_HOURLY_RATE_USD=0.00

